<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="17.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Knowit.Umbraco.SvgPicker\Knowit.Umbraco.SvgPicker.csproj" />
  </ItemGroup>

  <Target Name="EnsureUmbracoDirectories" BeforeTargets="Build">
    <MakeDir Directories="$(MSBuildThisFileDirectory)wwwroot\media" Condition="!Exists('$(MSBuildThisFileDirectory)wwwroot\media')" />
  </Target>

</Project>
