<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);client\node_modules\**;client\dist\**</DefaultItemExcludes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Knowit.Umbraco.SvgPicker</PackageId>
    <Version>1.0.1</Version>
    <Authors>Nicklas Vilhelmsen</Authors>
    <Company>Knowit</Company>
    <Copyright>Copyright © Knowit 2026</Copyright>
    <Description>Backoffice property editor for Umbraco 17 that adds a visual SVG icon picker. Editors browse and search symbols from any configured SVG spritesheet. Stores the symbol ID as a plain string and renders as svg/use in Razor via a built-in Html.SvgIcon() helper.</Description>
    <PackageTags>umbraco;umbraco17;svg;icon;picker;sprite;spritesheet;property-editor;backoffice;symbol;umbraco-marketplace</PackageTags>
    <PackageProjectUrl>https://github.com/Nicklasvilh96/Knowit.Umbraco.SvgPicker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Nicklasvilh96/Knowit.Umbraco.SvgPicker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.0.0, 18.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Plugins\**" CopyToOutputDirectory="Always" PackageCopyToOutput="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="icon.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

</Project>
